{
  "expo": {
    "name": "TattooHub",
    "slug": "tattoohub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F5F3EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.tattoohub.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "TattooHub utilise la camera pour vos references.",
        "NSPhotoLibraryUsageDescription": "TattooHub accede a vos photos pour le portfolio.",
        "NSPhotoLibraryAddUsageDescription": "TattooHub sauvegarde vos photos."
      }
    },
    "android": {
      "package": "fr.tattoohub.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-image-picker", {
        "photosPermission": "TattooHub accede a vos photos pour le portfolio."
      }]
    ],
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "tattoohub" }
    },
    "scheme": "tattoohub"
  }
}
